{
  "name": "bar-ops",
  "version": "1.5.168",
  "description": "Bar Ops — gestion d'événements bar",
  "author": "Jérôme Jarrige <Jarrige.jerome@hotmail.fr>",
  "license": "UNLICENSED",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "electron": "electron .",
    "build:mac": "electron-builder --mac",
    "build:ci": "electron-builder --mac -c.mac.target=zip",
    "build:win": "electron-builder --win",
    "build:all": "electron-builder --mac --win"
  },
  "build": {
    "appId": "com.barops.app",
    "productName": "Bar Ops",
    "afterPack": "scripts/afterPack.js",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/main.js",
      "electron/preload.js",
      "electron/app/**/*",
      "electron/assets/icon.*"
    ],
    "publish": {
      "provider": "github",
      "owner": "SPECTRE888",
      "repo": "bar-ops",
      "releaseType": "release"
    },
    "protocols": {
      "name": "Bar Ops",
      "schemes": [
        "barops"
      ]
    },
    "artifactName": "BarOps-${version}-${arch}-mac.${ext}",
    "mac": {
      "icon": "electron/assets/icon.icns",
      "identity": null,
      "hardenedRuntime": false,
      "entitlements": "electron/entitlements.mac.plist",
      "entitlementsInherit": "electron/entitlements.mac.plist",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.business"
    },
    "win": {
      "icon": "electron/assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "Bar Ops"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@sendgrid/mail": "^8.1.6",
    "@supabase/supabase-js": "^2.104.1",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.3",
    "stripe": "^22.1.0"
  },
  "devDependencies": {
    "electron": "^39.8.10",
    "electron-builder": "^26.15.0",
    "puppeteer": "^24.43.1",
    "sharp": "^0.34.5"
  }
}
